{
  "name": "@osloer-industries/markdown-link-check",
  "version": "4.0.0",
  "description": "Fork of markdown-link-check with upstream single-file checks plus repository-relative link validation for Node.js ESM projects.",
  "bin": {
    "markdown-link-check": "markdown-link-check",
    "markdown-link-check-repo": "./check-repo-cli.mjs"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "pretest": "eslint .",
    "test": "mocha -R spec --exit \"test/*.test.js\"",
    "test:repo": "node --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=index.mjs --test-coverage-include=check-repo.mjs test/repo-link-check.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osloer-industries/markdown-link-check.git"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "basic-ftp": "6.2.3"
  },
  "keywords": [
    "markdown",
    "md",
    "link",
    "hyperlink",
    "href",
    "check",
    "checker"
  ],
  "author": "Thomas Cort <linuxgeek@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/osloer-industries/markdown-link-check/issues"
  },
  "homepage": "https://github.com/osloer-industries/markdown-link-check#readme",
  "files": [
    "markdown-link-check",
    "index.mjs",
    "check-repo.mjs",
    "check-repo-cli.mjs",
    "ambient.d.ts",
    "LICENSE.md",
    "NOTICE.md",
    "README.md"
  ],
  "dependencies": {
    "async": "^3.2.6",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "link-check": "^5.6.0",
    "markdown-link-extractor": "^4.0.4",
    "needle": "^3.5.0",
    "progress": "^2.0.3",
    "proxy-agent": "^8.0.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "expect.js": "^0.3.1",
    "express": "^5.2.1",
    "globals": "^17.8.0",
    "mocha": "^11.7.6"
  }
}
